<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!--
    ModoCatalogos es el valor inicial; también se puede cambiar en caliente desde
    el interruptor "Datos del catálogo" al final de la solapa izquierda.
      Memoria -> catálogos en memoria, no se guarda nada al cerrar (por defecto).
      Local   -> catálogos en un archivo XML en %LOCALAPPDATA%\EventosPresupuestos.
                 No necesita MySQL ni ningún servidor.
  -->
  <appSettings>
    <add key="ModoCatalogos" value="Memoria" />
  </appSettings>
</configuration>
